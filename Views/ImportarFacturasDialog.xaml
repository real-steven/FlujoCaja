<Window x:Class="FlujoCajaWpf.Views.ImportarFacturasDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Resources/APPSamara.png"
        Title="Importar Facturas con IA"
        Height="680" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#1E3A8A" Offset="0.5"/>
                    <GradientStop Color="#3B82F6" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="🤖 Importar Facturas con IA"
                           FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="txtSubtitulo"
                           FontSize="12" Foreground="#E0E7FF" Margin="0,4,0,0"
                           Text="Arrastra facturas o comprobantes para que la IA los lea automáticamente"/>
            </StackPanel>
        </Border>

        <!-- Contenido -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16">

                <!-- Áreas de drag & drop - dos columnas -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ingresos -->
                    <Border Grid.Column="0"
                            x:Name="borderDropIngresos"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="#10B981" BorderThickness="2"
                            CornerRadius="12" Padding="20"
                            AllowDrop="True"
                            DragOver="BorderIngresos_DragOver"
                            DragLeave="BorderIngresos_DragLeave"
                            Drop="BorderIngresos_Drop"
                            Cursor="Hand">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="💰" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="INGRESOS" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center" Foreground="#059669" Margin="0,0,0,4"/>
                            <TextBlock Text="Arrastra facturas de ingresos aquí"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="0,0,0,12"/>
                            <Button x:Name="btnBuscarIngresos" Click="BuscarIngresos_Click"
                                    Background="#10B981" Foreground="White"
                                    BorderThickness="0" Padding="16,8"
                                    FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#059669"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="📁 Seleccionar archivos" FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Egresos -->
                    <Border Grid.Column="2"
                            x:Name="borderDropEgresos"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="#DC2626" BorderThickness="2"
                            CornerRadius="12" Padding="20"
                            AllowDrop="True"
                            DragOver="BorderEgresos_DragOver"
                            DragLeave="BorderEgresos_DragLeave"
                            Drop="BorderEgresos_Drop"
                            Cursor="Hand">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="💸" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="EGRESOS" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center" Foreground="#DC2626" Margin="0,0,0,4"/>
                            <TextBlock Text="Arrastra facturas de gastos aquí"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="0,0,0,12"/>
                            <Button x:Name="btnBuscarEgresos" Click="BuscarEgresos_Click"
                                    Background="#DC2626" Foreground="White"
                                    BorderThickness="0" Padding="16,8"
                                    FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#B91C1C"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="📁 Seleccionar archivos" FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Lista de archivos en proceso -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="#E5E7EB" BorderThickness="1"
                        CornerRadius="8" Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="📋 Archivos procesados"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="txtContadorArchivos"
                                       Text="0 archivos"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <ItemsControl x:Name="listaArchivos">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="10"
                                            CornerRadius="6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Icono}"
                                                       FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NombreArchivo}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Mensaje}"
                                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding TipoLabel}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding ColorTipo}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Mensaje vacío -->
                        <TextBlock x:Name="txtSinArchivos"
                                   Text="Aún no has importado archivos. Arrastra facturas a las áreas de arriba o usa los botones de selección."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextAlignment="Center" Margin="0,10"
                                   TextWrapping="Wrap" Visibility="Visible"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ProgressBar x:Name="progressBar"
                                 Width="200" Height="6"
                                 Visibility="Collapsed"
                                 IsIndeterminate="True"
                                 Margin="0,0,12,0"/>
                    <TextBlock x:Name="txtEstado"
                               Text=""
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✓ Cerrar" Click="Cerrar_Click"
                        HorizontalAlignment="Right"
                        Foreground="White" BorderThickness="0" Padding="20,9"
                        FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#10B981"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#059669"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
