<Window x:Class="FlujoCajaWpf.Views.FotoPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Resources/APPSamara.png"
        Title="Vista previa de factura"
        Width="820" Height="680"
        MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#1F2937">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Área de imagen con scroll -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="#111827" Margin="0">
            <Image x:Name="imgPreview" Stretch="Uniform" Margin="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </ScrollViewer>

        <!-- Overlay de carga -->
        <Grid Grid.Row="0" x:Name="gridCargando" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="txtCargando" Text="⏳ Cargando imagen…"
                           Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Barra inferior con botones -->
        <Border Grid.Row="1" Background="#374151" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Nombre del archivo -->
                <TextBlock x:Name="txtNombreArchivo" Grid.Column="0"
                           Foreground="#9CA3AF" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <!-- Botones -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnDescargar" Content="⬇️  Descargar"
                            Click="Descargar_Click" IsEnabled="False"
                            Foreground="White" BorderThickness="0"
                            Padding="18,9" FontSize="13" FontWeight="SemiBold"
                            Cursor="Hand" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#10B981"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#059669"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#6B7280"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="✕  Cerrar" Click="Cerrar_Click"
                            Foreground="White" BorderThickness="0"
                            Padding="18,9" FontSize="13" FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#6B7280"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#4B5563"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
