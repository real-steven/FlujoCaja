<Window x:Class="FlujoCajaWpf.Views.CrearUsuarioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Resources/APPSamara.png"
        Title="Crear Nuevo Usuario"
        Height="440" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#1E3A8A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="👤 Crear Nuevo Usuario"
                       FontSize="16" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16" x:Name="panelBody">

                <!-- Email -->
                <TextBlock Text="Email *" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <Border Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Margin="0,0,0,12">
                    <TextBox x:Name="txtEmail" BorderThickness="0" Padding="10,8"
                             Background="Transparent" FontSize="13"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Border>

                <!-- Contraseña -->
                <TextBlock Text="Contraseña *" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <Border Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Margin="0,0,0,12">
                    <PasswordBox x:Name="txtPassword" BorderThickness="0" Padding="10,8"
                                 Background="Transparent" FontSize="13"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Border>

                <!-- Nombre / Apellido -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nombre" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6">
                            <TextBox x:Name="txtNombre" BorderThickness="0" Padding="10,8"
                                     Background="Transparent" FontSize="13"
                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Apellido" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6">
                            <TextBox x:Name="txtApellido" BorderThickness="0" Padding="10,8"
                                     Background="Transparent" FontSize="13"
                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Rol -->
                <TextBlock Text="Rol" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <ComboBox x:Name="cmbRol" Padding="10,8" FontSize="13" Margin="0,0,0,12">
                    <ComboBoxItem Content="usuario" IsSelected="True"/>
                    <ComboBoxItem Content="admin"/>
                </ComboBox>

                <!-- Teléfono -->
                <TextBlock Text="Teléfono" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <Border Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Margin="0,0,0,4">
                    <TextBox x:Name="txtTelefono" BorderThickness="0" Padding="10,8"
                             Background="Transparent" FontSize="13"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Border>

                <!-- Error -->
                <TextBlock x:Name="txtError" Text="" Foreground="#EF4444"
                           FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="Cancelar_Click"
                        Padding="16,8" Margin="0,0,10,0"
                        Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#6B7280"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4B5563"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="✓ Crear Usuario" Click="Crear_Click"
                        Padding="20,8"
                        Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#10B981"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#059669"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
