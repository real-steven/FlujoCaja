<Window x:Class="FlujoCajaWpf.Views.AdjuntarImagenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Resources/APPSamara.png"
        Title="Adjuntar Imagen"
        Height="340" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="18,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#1E3A8A" Offset="0.5"/>
                    <GradientStop Color="#3B82F6" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="📎 Adjuntar Imagen"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- Contenido -->
        <StackPanel Grid.Row="1" Margin="18,16">

            <!-- Zona de drag & drop -->
            <Border x:Name="borderDrop"
                    AllowDrop="True"
                    DragOver="Border_DragOver"
                    DragLeave="Border_DragLeave"
                    Drop="Border_Drop"
                    MouseLeftButtonUp="Border_Click"
                    BorderBrush="#CBD5E1"
                    BorderThickness="2"
                    CornerRadius="10"
                    Background="#F8FAFC"
                    Height="160"
                    Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <!-- Estado vacío -->
                    <StackPanel x:Name="panelVacio"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="🖼️"
                                   FontSize="36"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Arrastra una imagen aquí"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="o haz clic para seleccionar"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="PNG, JPG, JPEG, WEBP"
                                   FontSize="11"
                                   Foreground="#9CA3AF"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Estado con imagen seleccionada -->
                    <Grid x:Name="panelSeleccionado" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="80" Height="80"
                                CornerRadius="8"
                                Margin="16,0,12,0"
                                ClipToBounds="True">
                            <Image x:Name="imgPreview"
                                   Stretch="UniformToFill"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                            <TextBlock Text="✅ Imagen seleccionada"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#10B981"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="txtNombreArchivo"
                                       FontSize="12"
                                       Foreground="#374151"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtTamanioArchivo"
                                       FontSize="11"
                                       Foreground="#6B7280"
                                       Margin="0,4,0,0"/>
                            <Button Content="🔄 Cambiar imagen"
                                    Click="CambiarImagen_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#3B82F6"
                                    FontSize="12"
                                    Cursor="Hand"
                                    HorizontalAlignment="Left"
                                    Margin="0,6,0,0"
                                    Padding="0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>

        <!-- Botones -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancelar"
                        Click="Cancelar_Click"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="0,11"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#6B7280"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4B5563"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="1"
                        x:Name="btnAdjuntar"
                        Content="📎 Adjuntar"
                        Click="Adjuntar_Click"
                        IsEnabled="False"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="0,11"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Margin="6,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#10B981"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#9CA3AF"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#059669"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
