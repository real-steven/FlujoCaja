<Window x:Class="FlujoCajaWpf.Views.VerImagenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Resources/APPSamara.png"
        Title="Imagen Adjunta"
        Height="780" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="18,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#1E3A8A" Offset="0.5"/>
                    <GradientStop Color="#3B82F6" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="🖼️ Imagen Adjunta"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- Contenido -->
        <StackPanel Grid.Row="1" Margin="18,14">

            <!-- Imagen actual -->
            <TextBlock Text="Imagen actual"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#6B7280"
                       Margin="0,0,0,6"/>
            <Border CornerRadius="10"
                    ClipToBounds="True"
                    Background="#F1F5F9"
                    Height="380"
                    Margin="0,0,0,14">
                <Grid>
                    <Image x:Name="imgActual"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="txtCargando"
                               Text="Cargando imagen..."
                               FontSize="13"
                               Foreground="#9CA3AF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Separador -->
            <Border Height="1" Background="#E5E7EB" Margin="0,0,0,14"/>

            <!-- Zona drag & drop para reemplazar -->
            <TextBlock Text="Reemplazar imagen"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#6B7280"
                       Margin="0,0,0,6"/>
            <Border x:Name="borderDropReplace"
                    AllowDrop="True"
                    DragOver="BorderReplace_DragOver"
                    DragLeave="BorderReplace_DragLeave"
                    Drop="BorderReplace_Drop"
                    MouseLeftButtonUp="BorderReplace_Click"
                    BorderBrush="#CBD5E1"
                    BorderThickness="2"
                    CornerRadius="10"
                    Background="#F8FAFC"
                    Height="120"
                    Cursor="Hand">

                <Grid>
                    <!-- Estado vacío -->
                    <StackPanel x:Name="panelReplaceVacio"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="🔄  Arrastra aquí para reemplazar o haz clic para elegir"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="PNG, JPG, JPEG, WEBP"
                                   FontSize="11"
                                   Foreground="#9CA3AF"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Estado con nueva imagen -->
                    <Grid x:Name="panelReplaceSeleccionado" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="65" Height="65"
                                CornerRadius="8"
                                Margin="12,0,10,0"
                                ClipToBounds="True">
                            <Image x:Name="imgNueva" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="✅ Nueva imagen seleccionada"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#10B981"
                                       Margin="0,0,0,3"/>
                            <TextBlock x:Name="txtNombreNueva"
                                       FontSize="11"
                                       Foreground="#374151"
                                       TextWrapping="Wrap"/>
                            <Button Content="🔄 Cambiar"
                                    Click="CambiarNueva_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#3B82F6"
                                    FontSize="11"
                                    Cursor="Hand"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>

        <!-- Botones -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Eliminar -->
                <Button Grid.Column="0"
                        Content="🗑️ Eliminar"
                        Click="Eliminar_Click"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="14,10"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#DC2626"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#B91C1C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Descargar -->
                <Button Grid.Column="2"
                        x:Name="btnDescargar"
                        Content="⬇️ Descargar"
                        Click="Descargar_Click"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="14,10"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#0EA5E9"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0284C7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Cerrar -->
                <Button Grid.Column="3"
                        Content="Cerrar"
                        Click="Cerrar_Click"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="14,10"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#6B7280"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4B5563"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Guardar cambio -->
                <Button Grid.Column="4"
                        x:Name="btnGuardar"
                        Content="✅ Guardar cambio"
                        Click="Guardar_Click"
                        IsEnabled="False"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="14,10"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#10B981"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#9CA3AF"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#059669"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </Grid>
        </Border>
    </Grid>
</Window>
