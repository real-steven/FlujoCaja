<Window x:Class="FlujoCajaWpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Resources/LogoSamaraRental.PNG"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Flujo de Caja - Login" 
        Height="550" Width="850"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel izquierdo - Logo y branding -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryGradient}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="/Resources/LogoSamaraRental.PNG" 
                       Width="150" Height="150" 
                       Margin="0,0,0,20"
                       Stretch="Uniform"/>
                <TextBlock Text="Sistema de Gestión" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="White"
                           TextAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Flujo de Caja" 
                           FontSize="16" 
                           Foreground="White"
                           TextAlignment="Center"
                           Opacity="0.9"/>
                
                <!-- Acento amarillo decorativo -->
                <Border Background="{StaticResource AccentYellowBrush}"
                        Width="60" Height="3"
                        CornerRadius="2"
                        Margin="0,20,0,0"/>
            </StackPanel>
        </Border>

        <!-- Panel derecho - Formulario de login -->
        <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}" Padding="30,15">
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="30">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.1" Color="Black"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Bienvenido" 
                               FontSize="26" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource DarkBlueBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Inicia sesión para continuar" 
                               FontSize="13" 
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,25"/>

                <!-- Email -->
                <TextBlock Text="Email" 
                           FontSize="14" 
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="txtEmail"
                         Style="{StaticResource ModernTextBox}"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,20"/>

                <!-- Contraseña -->
                <TextBlock Text="Contraseña" 
                           FontSize="14" 
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,8"/>
                <PasswordBox x:Name="txtPassword"
                             Style="{StaticResource ModernPasswordBox}"
                             PasswordChanged="txtPassword_PasswordChanged"
                             KeyDown="txtPassword_KeyDown"
                             Margin="0,0,0,6"/>

                <!-- Olvidé mi contraseña -->
                <TextBlock HorizontalAlignment="Right" Margin="0,0,0,12">
                    <Hyperlink x:Name="lnkOlvidePassword" Click="OlvidePassword_Click"
                               Foreground="#3B82F6" TextDecorations="None">
                        <Run Text="¿Olvidó su contraseña?" FontSize="12"/>
                    </Hyperlink>
                </TextBlock>

                <!-- Mensaje de error -->
                <TextBlock Text="{Binding MensajeError}" 
                           Foreground="{StaticResource AccentRedBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"
                           Visibility="{Binding TieneMensajeError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Botón de login -->
                <Button Content="Iniciar Sesión" 
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding IniciarSesionCommand}"
                        Height="45"
                        FontSize="16"
                        Margin="0,0,0,20"/>

                <!-- Loading indicator -->
                <ProgressBar IsIndeterminate="True" 
                             Height="4"
                             Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVisibilityConverter}}"
                             Margin="0,0,0,20"/>

                <!-- Texto informativo -->
                <TextBlock TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12">
                    <Run Text="Sistema de Gestión de Flujo de Caja"/>
                    <LineBreak/>
                    <Run Text="Playa Sámara © 2025"/>
                </TextBlock>

                <!-- Soporte -->
                </StackPanel>
            </Border>
        </Border>

        <!-- Botón soporte esquina superior derecha -->
        <Button x:Name="btnSoporte"
                Grid.Column="1"
                Click="Soporte_Click"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Margin="0,20,38,0"
                Width="38" Height="38"
                Cursor="Hand"
                FocusVisualStyle="{x:Null}"
                ToolTip="Contactar soporte técnico">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#3B82F6"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="19"
                                        Width="38" Height="38">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2563EB"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <!-- Ícono teléfono (Material Design: call) -->
            <Viewbox Width="20" Height="20" Stretch="Uniform">
                <Canvas Width="24" Height="24">
                    <Path Fill="White"
                          Data="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                </Canvas>
            </Viewbox>
        </Button>
    </Grid>
</Window>

