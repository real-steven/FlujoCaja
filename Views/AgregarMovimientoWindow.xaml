<Window x:Class="FlujoCajaWpf.Views.AgregarMovimientoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Resources/APPSamara.png"
        Title="Agregar Movimiento"
        Height="700" Width="550"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,15">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#1E3A8A" Offset="0.5"/>
                    <GradientStop Color="#3B82F6" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock x:Name="txtTitulo" 
                       Text="Nuevo Movimiento" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="White"/>
        </Border>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,15">
            <StackPanel>
                <!-- Tipo -->
                <TextBlock Text="Tipo*" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <ComboBox x:Name="cmbTipo"
                          SelectionChanged="CmbTipo_SelectionChanged"
                          Background="{DynamicResource InputBackgroundBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1"
                          Padding="10,8"
                          FontSize="13"
                          Margin="0,0,0,12">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <ToggleButton x:Name="ToggleButton"
                                                          Grid.Column="2"
                                                          Focusable="false"
                                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                          ClickMode="Press">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border x:Name="Border" 
                                                                            Background="{DynamicResource InputBackgroundBrush}"
                                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="8">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition/>
                                                                                <ColumnDefinition Width="32"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <ContentPresenter Grid.Column="0"/>
                                                                            <Path Grid.Column="1"
                                                                                  x:Name="Arrow"
                                                                                  Fill="#6B7280"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Data="M 0 0 L 4 4 L 8 0 Z"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                            <ContentPresenter x:Name="ContentSite"
                                                              IsHitTestVisible="False"
                                                              Content="{TemplateBinding SelectionBoxItem}"
                                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                              Margin="10,8,32,8"
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="Left"
                                                              TextElement.Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Popup x:Name="Popup"
                                                   Placement="Bottom"
                                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                                   AllowsTransparency="True"
                                                   Focusable="False"
                                                   PopupAnimation="Slide">
                                                <Grid x:Name="DropDown"
                                                      SnapsToDevicePixels="True"
                                                      MinWidth="{TemplateBinding ActualWidth}"
                                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                    <Border x:Name="DropDownBorder"
                                                            Background="{DynamicResource CardBackgroundBrush}"
                                                            BorderThickness="1"
                                                            BorderBrush="#E5E7EB"
                                                            CornerRadius="8">
                                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                        </ScrollViewer>
                                                    </Border>
                                                </Grid>
                                            </Popup>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.Style>
                    <ComboBoxItem Content="💰 Ingreso" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ComboBoxItem Content="💸 Egreso" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </ComboBox>

                <!-- Categoría -->
                <TextBlock Text="Categoría*" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="cmbCategoria"
                              IsEditable="True"
                              DisplayMemberPath="Nombre"
                              FontSize="13"
                              ToolTip="Selecciona una categoría existente o escribe una nueva">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBox">
                                            <Grid>
                                                <Border Background="{DynamicResource InputBackgroundBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="32"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="PART_EditableTextBox"
                                                                 Grid.Column="0"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                                 SelectionBrush="{DynamicResource TextPrimaryBrush}"
                                                                 Padding="10,8"
                                                                 FontSize="13"
                                                                 VerticalAlignment="Center"
                                                                 IsReadOnly="{TemplateBinding IsReadOnly}"/>
                                                        <ToggleButton Grid.Column="1"
                                                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                      Background="Transparent"
                                                                      BorderThickness="0"
                                                                      Focusable="False"
                                                                      ClickMode="Press"
                                                                      Cursor="Hand">
                                                            <Path Fill="{DynamicResource TextSecondaryBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Data="M 0 0 L 4 4 L 8 0 Z"/>
                                                        </ToggleButton>
                                                    </Grid>
                                                </Border>
                                                <Popup x:Name="PART_Popup"
                                                       Placement="Bottom"
                                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                                       AllowsTransparency="True"
                                                       Focusable="False"
                                                       PopupAnimation="Slide">
                                                    <Border Background="{DynamicResource InputBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            MinWidth="{TemplateBinding ActualWidth}"
                                                            MaxHeight="200"
                                                            CornerRadius="8">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,6,4,6">
                                                            <StackPanel IsItemsHost="True"
                                                                        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        </ScrollViewer>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                </Grid>
                <CheckBox x:Name="chkGuardarCategoria"
                          Content="💾 Guardar esta categoría para uso futuro"
                          FontSize="12"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Margin="0,5,0,12"
                          ToolTip="Si está marcado, la categoría se guardará en la base de datos y estará disponible en el futuro"/>

                <!-- Monto -->
                <TextBlock x:Name="lblMonto" Text="Monto*" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="txtMonto"
                         Background="{DynamicResource InputBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         Padding="10,8"
                         FontSize="13"
                         Margin="0,0,0,12"
                         PreviewTextInput="TxtMonto_PreviewTextInput">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="5,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Fecha -->
                <TextBlock Text="Fecha*" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <DatePicker x:Name="dpFecha"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            FontSize="13"
                            Margin="0,0,0,12">
                    <DatePicker.Style>
                        <Style TargetType="DatePicker">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DatePicker">
                                        <Border Background="{DynamicResource InputBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <DatePickerTextBox x:Name="PART_TextBox"
                                                                   Grid.Column="0"
                                                                   Background="Transparent"
                                                                   BorderThickness="0"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="13"/>
                                                <Button x:Name="PART_Button"
                                                        Grid.Column="1"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                                        Cursor="Hand"
                                                        Width="28">
                                                    <Path Data="M6 2v2M18 2v2M3 8h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"
                                                          Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"
                                                          Width="16" Height="16" Stretch="Uniform"/>
                                                </Button>
                                                <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=PART_Button}"
                                                       Placement="Bottom" AllowsTransparency="True"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="CalendarStyle">
                                <Setter.Value>
                                    <Style TargetType="Calendar">
                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    </Style>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DatePicker.Style>
                </DatePicker>

                <!-- Descripción -->
                <TextBlock Text="Descripción" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="txtDescripcion"
                         Background="{DynamicResource InputBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         Padding="10,8"
                         FontSize="13"
                         Height="80"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,12">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="5"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Imagen (opcional) -->
                <TextBlock Text="Imagen (opcional)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <Border x:Name="borderDragDropMov"
                        AllowDrop="True"
                        DragOver="DragDropMov_DragOver"
                        DragLeave="DragDropMov_DragLeave"
                        Drop="DragDropMov_Drop"
                        MouseLeftButtonUp="DragDropMov_Click"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="2"
                        CornerRadius="10"
                        Background="{DynamicResource CardBackgroundBrush}"
                        Height="110"
                        Cursor="Hand"
                        Margin="0,0,0,12">
                    <Grid>
                        <!-- Estado vacío -->
                        <StackPanel x:Name="panelDragDropVacio"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="📎"
                                       FontSize="28"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="Arrastra una imagen o haz clic para seleccionar"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="PNG, JPG, JPEG, WEBP"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Estado con imagen seleccionada -->
                        <Grid x:Name="panelDragDropSeleccionado" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="70" Height="70"
                                    CornerRadius="8"
                                    Margin="14,0,10,0"
                                    ClipToBounds="True">
                                <Image x:Name="imgPreviewMov" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="✅ Imagen seleccionada"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#10B981"
                                           Margin="0,0,0,3"/>
                                <TextBlock x:Name="txtNombreArchivoMov"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"/>
                                <Button Content="🔄 Cambiar"
                                        Click="CambiarImagenMov_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#3B82F6"
                                        FontSize="11"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"
                                        Margin="0,4,0,0"
                                        Padding="0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Botones -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" Padding="20,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Click="Cancelar_Click"
                        Background="#6B7280"
                        Foreground="White"
                        BorderBrush="Transparent"
                        Padding="0,12"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Margin="0,0,5,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4B5563"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="Cancelar" FontSize="14" FontWeight="SemiBold"/>
                </Button>

                <Button Grid.Column="1"
                        Click="Guardar_Click"
                        Background="#10B981"
                        Foreground="White"
                        BorderBrush="Transparent"
                        Padding="0,12"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Margin="5,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#10B981"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#059669"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="💾 Guardar" FontSize="14" FontWeight="SemiBold"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
