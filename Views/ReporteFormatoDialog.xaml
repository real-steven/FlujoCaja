<Window x:Class="FlujoCajaWpf.Views.ReporteFormatoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Resources/APPSamara.png"
        Title="Generar Reporte Mensual"
        Height="320" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="18,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#1E3A8A" Offset="0.5"/>
                    <GradientStop Color="#3B82F6" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="📊 Reporte Mensual"
                           FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="txtSubtitulo"
                           FontSize="12" Foreground="#E0E7FF" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Pregunta + botones de formato -->
        <StackPanel Grid.Row="1" Margin="24,18" VerticalAlignment="Center">
            <TextBlock Text="¿Qué tipo de PDF deseas generar?"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- PDF Tabla -->
                <Button Grid.Column="0" Click="GenerarPdf_Click"
                        Foreground="White" BorderThickness="0" Padding="0,14"
                        FontSize="14" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#6366F1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4F46E5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel>
                        <TextBlock Text="📋" FontSize="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tabla Movimientos" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock Text="Sin imágenes" FontSize="10" HorizontalAlignment="Center" Opacity="0.85"/>
                    </StackPanel>
                </Button>

                <!-- PDF Facturas -->
                <Button Grid.Column="2" Click="GenerarPdfFacturas_Click"
                        Foreground="White" BorderThickness="0" Padding="0,14"
                        FontSize="14" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#059669"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#047857"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel>
                        <TextBlock Text="🖼️" FontSize="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="Imágenes Facturas" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock Text="Con comprobantes" FontSize="10" HorizontalAlignment="Center" Opacity="0.85"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Cancelar -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="18,10">
            <Button Content="Cancelar" Click="Cancelar_Click"
                    Foreground="White" BorderThickness="0" Padding="0,9"
                    FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#6B7280"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4B5563"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Border>
    </Grid>
</Window>
